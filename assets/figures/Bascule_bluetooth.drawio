        <mxCell id="ndef" value="démarrage de l'audio différé" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=none;fontSize=10;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="35" y="140" width="150" height="36" as="geometry" />
